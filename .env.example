# ===== إعدادات قاعدة البيانات =====
# قم بتغيير user وpassword وaatabase_name إلى القيم الفعلية على السيرفر
DATABASE_URL=mysql+pymysql://bellagio_user:STRONG_PASSWORD@localhost/bellagio_db

# ===== إعدادات الأمان =====
# مفتاح سري عشوائي طويل — قم بتوليده بـ: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING

# ===== إعدادات السيرفر =====
# عدد العمليات (workers) — اتركه فارغاً ليُحسب تلقائياً من عدد الأنوية
# BELLAGIO_WORKERS=2

# حجم connection pool لكل عملية (الافتراضي: 15)
# DB_POOL_SIZE=15
# DB_MAX_OVERFLOW=30

# ===== إعدادات درب السبيل (اختياري) =====
DARB_ASSABIL_BASE_URL=https://v2.sabil.ly
DARB_ASSABIL_API_KEY=YOUR_DARB_API_KEY_HERE
DARB_ASSABIL_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE
